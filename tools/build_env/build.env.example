# Конфигурация для загрузки в App Store Connect
# 
# Настройка:
# 1. Скопируйте в build.env и заполните ваши данные
# 2. Используйте --upload при сборке iOS

# App Store Connect API
# 1. Создайте API ключ: https://appstoreconnect.apple.com/access/api
# 2. Поместите .p8 файл в эту директорию
# 3. Заполните данные ниже:

# Путь к .p8 файлу API ключа (относительно tools/build/)
APPSTORE_API_KEY_PATH="AuthKey_XXXXXXXXXX.p8"

# Key ID (10-символьный идентификатор из имени файла)
APPSTORE_API_KEY_ID="XXXXXXXXXX"

# Issuer ID (UUID, найдите в App Store Connect → Users and Access → Keys)
APPSTORE_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Пример:
# APPSTORE_API_KEY_PATH="AuthKey_2X9R4HXF34.p8"
# APPSTORE_API_KEY_ID="2X9R4HXF34"  
# APPSTORE_ISSUER_ID="69a6de80-cf47-47e3-e053-5b8c7c11a4d1"
